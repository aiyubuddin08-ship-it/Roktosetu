rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Core Security Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ('admin' in request.auth.token && request.auth.token.admin == true)
      );
    }

    function isOrgAdmin(orgId) {
      return isSignedIn() && isValidId(orgId) && (
        isAdmin() ||
        ('orgId' in request.auth.token && request.auth.token.orgId == orgId) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
         request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUids)
      );
    }

    function isValidBloodGroup(bg) {
      return bg is string && bg in [
        'A_POSITIVE', 'A_NEGATIVE',
        'B_POSITIVE', 'B_NEGATIVE',
        'O_POSITIVE', 'O_NEGATIVE',
        'AB_POSITIVE', 'AB_NEGATIVE'
      ];
    }

    function isValidAvailability(avail) {
      return avail is string && avail in [
        'AVAILABLE', 'RESTING', 'EMERGENCY_ONLY', 'UNAVAILABLE'
      ];
    }

    function isValidVerificationStatus(status) {
      return status is string && status in [
        'UNVERIFIED', 'PENDING', 'VERIFIED', 'REJECTED'
      ];
    }

    function isValidUserRole(role) {
      return role is string && role in [
        'USER', 'ORG_ADMIN', 'SUPER_ADMIN'
      ];
    }

    function isValidUrgency(urgency) {
      return urgency is string && urgency in [
        'STANDARD', 'HIGH', 'CRITICAL_EMERGENCY'
      ];
    }

    function isValidRequestStatus(status) {
      return status is string && status in [
        'PENDING', 'DONOR_RESPONDED', 'ACCEPTED', 'FULFILLED', 'CANCELLED', 'EXPIRED'
      ];
    }

    // =========================================================================
    // Entity Schema Validation Helpers
    // =========================================================================

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             isValidBloodGroup(data.bloodGroup) &&
             (!('dateOfBirth' in data) || data.dateOfBirth == null || (data.dateOfBirth is string && data.dateOfBirth.size() <= 30)) &&
             data.isDonor is bool &&
             isValidAvailability(data.donorAvailability) &&
             (!('lastDonationDate' in data) || data.lastDonationDate == null || data.lastDonationDate is int) &&
             (!('isEmergencyDonor' in data) || data.isEmergencyDonor is bool) &&
             data.contactPhone is string && data.contactPhone.size() >= 6 && data.contactPhone.size() <= 25 &&
             data.showPhonePublicly is bool &&
             (!('division' in data) || data.division == null || (data.division is string && data.division.size() <= 60)) &&
             (!('district' in data) || data.district == null || (data.district is string && data.district.size() <= 60)) &&
             (!('upazila' in data) || data.upazila == null || (data.upazila is string && data.upazila.size() <= 60)) &&
             (!('area' in data) || data.area == null || (data.area is string && data.area.size() <= 100)) &&
             (!('city' in data) || data.city == null || (data.city is string && data.city.size() <= 60)) &&
             (!('location' in data) || data.location == null || data.location is map) &&
             isValidVerificationStatus(data.verificationStatus) &&
             isValidUserRole(data.role) &&
             (!('organizationId' in data) || data.organizationId == null || (data.organizationId is string && data.organizationId.size() <= 128)) &&
             data.donationCount is int && data.donationCount >= 0 &&
             (!('badges' in data) || (data.badges is list && data.badges.size() <= 20)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('fcmToken' in data) || data.fcmToken == null || (data.fcmToken is string && data.fcmToken.size() <= 500)) &&
             data.createdAt is int &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is int);
    }

    function isValidPublicDonor(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             isValidBloodGroup(data.bloodGroup) &&
             isValidAvailability(data.availability) &&
             data.division is string && data.division.size() <= 60 &&
             data.district is string && data.district.size() <= 60 &&
             data.upazila is string && data.upazila.size() <= 60 &&
             data.area is string && data.area.size() <= 100 &&
             (!('generalLocation' in data) || (data.generalLocation is string && data.generalLocation.size() <= 200)) &&
             data.isDonor is bool &&
             (!('isEmergencyDonor' in data) || data.isEmergencyDonor is bool) &&
             (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 25)) &&
             isValidVerificationStatus(data.verificationStatus) &&
             data.donationCount is int && data.donationCount >= 0 &&
             (!('lastDonationDate' in data) || data.lastDonationDate == null || data.lastDonationDate is int) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is int);
    }

    function isValidBloodRequest(data) {
      return data.requesterUid is string && data.requesterUid.size() >= 1 && data.requesterUid.size() <= 128 &&
             data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 100 &&
             data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 100 &&
             data.patientAge is int && data.patientAge >= 0 && data.patientAge <= 130 &&
             isValidBloodGroup(data.bloodGroup) &&
             data.unitsRequired is int && data.unitsRequired >= 1 && data.unitsRequired <= 20 &&
             data.hospitalName is string && data.hospitalName.size() >= 2 && data.hospitalName.size() <= 150 &&
             (!('hospitalAddress' in data) || (data.hospitalAddress is string && data.hospitalAddress.size() <= 200)) &&
             data.division is string && data.division.size() >= 1 && data.division.size() <= 60 &&
             data.district is string && data.district.size() >= 1 && data.district.size() <= 60 &&
             (!('upazila' in data) || (data.upazila is string && data.upazila.size() <= 60)) &&
             (!('area' in data) || (data.area is string && data.area.size() <= 100)) &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 60 &&
             isValidUrgency(data.urgency) &&
             isValidRequestStatus(data.status) &&
             data.contactPhone is string && data.contactPhone.size() >= 6 && data.contactPhone.size() <= 25 &&
             (!('medicalReason' in data) || (data.medicalReason is string && data.medicalReason.size() <= 300)) &&
             (!('acceptedDonorUid' in data) || data.acceptedDonorUid == null || (data.acceptedDonorUid is string && data.acceptedDonorUid.size() <= 128)) &&
             (!('acceptedDonorName' in data) || data.acceptedDonorName == null || (data.acceptedDonorName is string && data.acceptedDonorName.size() <= 100)) &&
             (!('respondedDonorUids' in data) || (data.respondedDonorUids is list && data.respondedDonorUids.size() <= 20)) &&
             (!('isEmergencyBroadcast' in data) || data.isEmergencyBroadcast is bool) &&
             data.createdAt is int &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is int) &&
             (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is int);
    }

    function isValidDonationRecord(data) {
      return data.donorUid is string && data.donorUid.size() >= 1 && data.donorUid.size() <= 128 &&
             data.donorName is string && data.donorName.size() >= 2 && data.donorName.size() <= 100 &&
             isValidBloodGroup(data.bloodGroup) &&
             (!('requestId' in data) || data.requestId == null || (data.requestId is string && data.requestId.size() <= 128)) &&
             data.hospitalName is string && data.hospitalName.size() >= 2 && data.hospitalName.size() <= 150 &&
             (!('city' in data) || (data.city is string && data.city.size() <= 60)) &&
             data.donationDate is int &&
             (!('verifiedByOrgId' in data) || data.verifiedByOrgId == null || (data.verifiedByOrgId is string && data.verifiedByOrgId.size() <= 128)) &&
             (!('verifiedByOrgName' in data) || data.verifiedByOrgName == null || (data.verifiedByOrgName is string && data.verifiedByOrgName.size() <= 120)) &&
             data.unitsDonated is int && data.unitsDonated >= 1 && data.unitsDonated <= 5 &&
             (!('certificateCode' in data) || (data.certificateCode is string && data.certificateCode.size() <= 64));
    }

    function isValidOrganization(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             data.registrationNumber is string && data.registrationNumber.size() >= 2 && data.registrationNumber.size() <= 60 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             data.headquartersCity is string && data.headquartersCity.size() >= 2 && data.headquartersCity.size() <= 60 &&
             (!('division' in data) || (data.division is string && data.division.size() <= 60)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 60)) &&
             (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 150)) &&
             data.contactPhone is string && data.contactPhone.size() >= 6 && data.contactPhone.size() <= 25 &&
             data.isVerified is bool &&
             data.adminUids is list && data.adminUids.size() >= 1 && data.adminUids.size() <= 10 && data.adminUids[0] is string &&
             (!('memberCount' in data) || (data.memberCount is int && data.memberCount >= 0)) &&
             (!('totalBagsCollected' in data) || (data.totalBagsCollected is int && data.totalBagsCollected >= 0)) &&
             data.createdAt is int;
    }

    function isValidCampaign(data) {
      return data.organizationId is string && data.organizationId.size() >= 1 && data.organizationId.size() <= 128 &&
             data.organizationName is string && data.organizationName.size() >= 2 && data.organizationName.size() <= 120 &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             data.location is string && data.location.size() >= 2 && data.location.size() <= 150 &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 60 &&
             (!('startDate' in data) || data.startDate is int) &&
             (!('endDate' in data) || data.endDate is int) &&
             data.targetBags is int && data.targetBags >= 1 && data.targetBags <= 10000 &&
             data.collectedBags is int && data.collectedBags >= 0 &&
             (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 25)) &&
             data.isActive is bool;
    }

    function isValidConversation(data) {
      return data.participants is list &&
             data.participants.size() == 2 &&
             data.participants[0] is string &&
             data.participants[1] is string &&
             data.participants[0] != data.participants[1] &&
             (!('participantNames' in data) || data.participantNames is map) &&
             (!('participantBloodGroups' in data) || data.participantBloodGroups is map) &&
             data.lastMessage is string && data.lastMessage.size() <= 1000 &&
             data.lastMessageTimestamp is int &&
             (!('requestId' in data) || data.requestId == null || (data.requestId is string && data.requestId.size() <= 128));
    }

    function isValidChatMessage(data) {
      return data.conversationId is string && data.conversationId.size() >= 1 && data.conversationId.size() <= 128 &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
             data.timestamp is int;
    }

    function isValidVerificationRequest(data) {
      return data.applicantUid is string && data.applicantUid.size() >= 1 && data.applicantUid.size() <= 128 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             data.type is string && data.type in ['DONOR', 'DONOR_CARD', 'ORGANIZATION'] &&
             (!('documents' in data) || (data.documents is list && data.documents.size() <= 10)) &&
             data.status is string && data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.submittedAt is int &&
             (!('reviewedByUid' in data) || data.reviewedByUid == null || (data.reviewedByUid is string && data.reviewedByUid.size() <= 128)) &&
             (!('reviewedAt' in data) || data.reviewedAt == null || data.reviewedAt is int);
    }

    // =========================================================================
    // 0. Trusted Admin Registry (Server-Managed Only)
    // =========================================================================
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list, create, update, delete: if false;
    }

    // =========================================================================
    // 1. Private User Profiles (/users/{userId}) - Strictly Isolated PII
    // =========================================================================
    match /users/{userId} {
      // Only the profile owner or a system admin may read private PII (email, DOB, private phone, FCM token)
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // Users can create only their own profile with unprivileged initial values (or designated admin profile)
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == request.auth.uid && (
                         (incoming().role == 'USER' &&
                          incoming().verificationStatus == 'UNVERIFIED' &&
                          incoming().donationCount == 0 &&
                          incoming().isEmergencyDonor == false) ||
                         isAdmin()
                       );

      // Users can update only permitted profile fields; privileged & immutable fields are locked
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) && (
                         (isOwner(userId) &&
                          incoming().uid == existing().uid &&
                          incoming().role == existing().role &&
                          (incoming().verificationStatus == existing().verificationStatus ||
                           (existing().verificationStatus in ['UNVERIFIED', 'REJECTED', 'PENDING'] &&
                            incoming().verificationStatus == 'PENDING')) &&
                          incoming().donationCount == existing().donationCount &&
                          incoming().createdAt == existing().createdAt &&
                          !incoming().diff(existing()).affectedKeys().hasAny([
                            'uid', 'role', 'donationCount', 'badges', 'organizationId', 'createdAt'
                          ])) ||
                         isAdmin()
                       );

      allow delete: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());

      // User Notifications Subcollection
      match /notifications/{notificationId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isAdmin();
        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(notificationId) &&
                         isOwner(userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['isRead']) &&
                         incoming().isRead is bool;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin());
      }
    }

    // =========================================================================
    // 2. Sanitized Public Donor Directory (/public_donors/{donorUid})
    // =========================================================================
    match /public_donors/{donorUid} {
      allow get: if isSignedIn() && isValidId(donorUid) && (resource.data.isDonor == true || isOwner(donorUid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.isDonor == true || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(donorUid) &&
                       isOwner(donorUid) &&
                       isValidPublicDonor(incoming()) &&
                       incoming().uid == request.auth.uid && (
                         (incoming().verificationStatus == 'UNVERIFIED' &&
                          incoming().donationCount == 0) ||
                         isAdmin()
                       );

      allow update: if isSignedIn() &&
                       isValidId(donorUid) &&
                       isValidPublicDonor(incoming()) && (
                         (isOwner(donorUid) &&
                          incoming().uid == existing().uid &&
                          (incoming().verificationStatus == existing().verificationStatus ||
                           (existing().verificationStatus in ['UNVERIFIED', 'REJECTED', 'PENDING'] &&
                            incoming().verificationStatus == 'PENDING')) &&
                          incoming().donationCount == existing().donationCount &&
                          !incoming().diff(existing()).affectedKeys().hasAny([
                            'uid', 'donationCount'
                          ])) ||
                         isAdmin()
                       );

      allow delete: if isSignedIn() && isValidId(donorUid) && (isOwner(donorUid) || isAdmin());
    }

    // =========================================================================
    // 3. Emergency Blood Requests (/blood_requests/{requestId})
    // =========================================================================
    match /blood_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId);
      allow list: if isSignedIn() && (
        resource.data.status in ['PENDING', 'DONOR_RESPONDED', 'ACCEPTED', 'FULFILLED', 'CANCELLED', 'EXPIRED']
      );

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       isValidBloodRequest(incoming()) &&
                       incoming().requesterUid == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       (!('acceptedDonorUid' in incoming()) || incoming().acceptedDonorUid == null || incoming().acceptedDonorUid == '');

      allow update: if isSignedIn() &&
                       isValidId(requestId) &&
                       isValidBloodRequest(incoming()) &&
                       incoming().requesterUid == existing().requesterUid &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           // Terminal state lock: cannot mutate once FULFILLED, CANCELLED, or EXPIRED
                           !(existing().status in ['FULFILLED', 'CANCELLED', 'EXPIRED']) && (
                             // Action 1: Authorized Donor responds/commits to a PENDING request (cannot self-accept own request)
                             (request.auth.uid != existing().requesterUid &&
                              existing().status == 'PENDING' &&
                              incoming().status in ['DONOR_RESPONDED', 'ACCEPTED'] &&
                              incoming().acceptedDonorUid == request.auth.uid &&
                              incoming().diff(existing()).affectedKeys().hasOnly([
                                'status', 'acceptedDonorUid', 'acceptedDonorName', 'respondedDonorUids', 'updatedAt'
                              ])) ||
                             // Action 2: Requester cancels their active request
                             (isOwner(existing().requesterUid) &&
                              existing().status in ['PENDING', 'DONOR_RESPONDED', 'ACCEPTED'] &&
                              incoming().status == 'CANCELLED' &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                             // Action 3: Requester marks request FULFILLED only after a donor has responded/accepted
                             (isOwner(existing().requesterUid) &&
                              existing().status in ['DONOR_RESPONDED', 'ACCEPTED'] &&
                              existing().acceptedDonorUid != null &&
                              existing().acceptedDonorUid != '' &&
                              incoming().status == 'FULFILLED' &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                             // Action 4: Requester updates request details while still PENDING
                             (isOwner(existing().requesterUid) &&
                              existing().status == 'PENDING' &&
                              incoming().status == 'PENDING' &&
                              incoming().diff(existing()).affectedKeys().hasOnly([
                                'patientName', 'patientAge', 'unitsRequired', 'hospitalName',
                                'hospitalAddress', 'division', 'district', 'upazila', 'area',
                                'city', 'urgency', 'contactPhone', 'medicalReason', 'updatedAt'
                              ]))
                           )
                         )
                       );

      allow delete: if isSignedIn() && isValidId(requestId) && (
        (isOwner(existing().requesterUid) && existing().status in ['PENDING', 'CANCELLED']) ||
        isAdmin()
      );
    }

    // =========================================================================
    // 4. Verified Donation Records (/donations/{donationId})
    // =========================================================================
    match /donations/{donationId} {
      allow get: if isSignedIn() && isValidId(donationId) && (
        resource.data.donorUid == request.auth.uid ||
        isAdmin() ||
        (resource.data.verifiedByOrgId != null && isOrgAdmin(resource.data.verifiedByOrgId))
      );
      allow list: if isSignedIn() && (
        resource.data.donorUid == request.auth.uid ||
        isAdmin()
      );

      // Users cannot create or forge their own donation records
      allow create, update: if isSignedIn() &&
                               isValidId(donationId) &&
                               isValidDonationRecord(incoming()) && (
                                 isAdmin() ||
                                 (incoming().verifiedByOrgId != null && isOrgAdmin(incoming().verifiedByOrgId))
                               );
      allow delete: if isSignedIn() && isValidId(donationId) && isAdmin();
    }

    // =========================================================================
    // 5. Organizations (/organizations/{orgId})
    // =========================================================================
    match /organizations/{orgId} {
      allow get: if isSignedIn() && isValidId(orgId);
      allow list: if isSignedIn() && (
        resource.data.isVerified == true ||
        request.auth.uid in resource.data.adminUids ||
        isAdmin()
      );

      // Organization creation starts unverified and requires admin approval
      allow create: if isSignedIn() &&
                       isValidId(orgId) &&
                       isValidOrganization(incoming()) &&
                       incoming().isVerified == false &&
                       incoming().totalBagsCollected == 0 &&
                       request.auth.uid in incoming().adminUids;

      // Org admins can update details, but CANNOT self-verify or alter registration/bag counts
      allow update: if isSignedIn() &&
                       isValidId(orgId) &&
                       isValidOrganization(incoming()) && (
                         (isOrgAdmin(orgId) &&
                          incoming().isVerified == existing().isVerified &&
                          incoming().registrationNumber == existing().registrationNumber &&
                          incoming().createdAt == existing().createdAt &&
                          !incoming().diff(existing()).affectedKeys().hasAny([
                            'isVerified', 'registrationNumber', 'totalBagsCollected', 'createdAt'
                          ])) ||
                         isAdmin()
                       );

      allow delete: if isSignedIn() && isValidId(orgId) && isAdmin();

      match /campaigns/{campaignId} {
        allow get, list: if isSignedIn() && isValidId(orgId);
        allow create, update: if isSignedIn() && isValidId(orgId) && isValidId(campaignId) && isValidCampaign(incoming()) && isOrgAdmin(orgId);
        allow delete: if isSignedIn() && isValidId(orgId) && isValidId(campaignId) && isOrgAdmin(orgId);
      }
    }

    // =========================================================================
    // 6. Top-Level Campaigns (/campaigns/{campaignId})
    // =========================================================================
    match /campaigns/{campaignId} {
      allow get: if isSignedIn() && isValidId(campaignId);
      allow list: if isSignedIn() && (resource.data.isActive == true || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(campaignId) &&
                       isValidCampaign(incoming()) && (
                         isAdmin() ||
                         isOrgAdmin(incoming().organizationId) ||
                         incoming().organizationId == request.auth.uid
                       );
      allow update: if isSignedIn() &&
                       isValidId(campaignId) &&
                       isValidCampaign(incoming()) && (
                         isAdmin() ||
                         isOrgAdmin(existing().organizationId) ||
                         (existing().organizationId == request.auth.uid &&
                          incoming().organizationId == existing().organizationId)
                       );
      allow delete: if isSignedIn() && isValidId(campaignId) && isAdmin();
    }

    // =========================================================================
    // 7. 1-to-1 Conversations & Messages (/conversations/{convId})
    // =========================================================================
    match /conversations/{convId} {
      allow get: if isSignedIn() && isValidId(convId) && (request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants);

      allow create: if isSignedIn() &&
                       isValidId(convId) &&
                       isValidConversation(incoming()) &&
                       (request.auth.uid in incoming().participants);

      // Participants CANNOT modify the participants list after creation
      allow update: if isSignedIn() &&
                       isValidId(convId) &&
                       isValidConversation(incoming()) &&
                       (request.auth.uid in existing().participants) &&
                       incoming().participants == existing().participants &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'lastMessage', 'lastMessageTimestamp', 'participantNames', 'participantBloodGroups', 'requestId'
                       ]);

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isSignedIn() &&
                            isValidId(convId) &&
                            (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants);

        allow create: if isSignedIn() &&
                         isValidId(convId) &&
                         isValidId(messageId) &&
                         isValidChatMessage(incoming()) &&
                         incoming().conversationId == convId &&
                         incoming().senderUid == request.auth.uid &&
                         (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants);

        allow update, delete: if false;
      }
    }

    // =========================================================================
    // 8. Verification Requests Queue (/verification_requests/{taskId})
    // =========================================================================
    match /verification_requests/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && (resource.data.applicantUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.applicantUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(taskId) &&
                       isValidVerificationRequest(incoming()) &&
                       incoming().applicantUid == request.auth.uid &&
                       incoming().status == 'PENDING';

      allow update, delete: if isSignedIn() && isValidId(taskId) && isAdmin();
    }

    // =========================================================================
    // 9. System Configuration & Audit Logs (Admin-Controlled)
    // =========================================================================
    match /system_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list, create, update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
