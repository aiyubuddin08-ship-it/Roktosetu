rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOrgAdmin(orgId) {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.orgId == orgId ||
        (
          exists(/databases/$(database)/documents/organizations/$(orgId)) &&
          request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.adminUids
        )
      );
    }

    // 1. Private User Profiles (Strict User Privacy - Owner & Admin Only)
    match /users/{userId} {
      // Normal users can ONLY read their own private profile document
      allow read: if isOwner(userId) || isAdmin();

      // Only user can create their own document with safe initial defaults
      allow create: if isOwner(userId)
        && request.resource.data.role == 'USER'
        && request.resource.data.verificationStatus == 'UNVERIFIED'
        && request.resource.data.donationCount == 0;

      // User can update non-privileged fields, but NOT role, verificationStatus, donationCount, or createdAt
      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'verificationStatus', 'donationCount', 'createdAt'
        ])) || isAdmin();

      allow delete: if isOwner(userId) || isAdmin();

      // Notifications subcollection - read only by owner
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if isAdmin();
      }
    }

    // 2. Safe Public Donors Collection (Sanitized for Donor Discovery)
    match /public_donors/{donorId} {
      // Authenticated users can discover donors
      allow read: if isAuthenticated();

      // Donors can create/update their own discovery card, but cannot forge verificationStatus or donationCount
      allow create: if isOwner(donorId)
        && request.resource.data.verificationStatus == 'UNVERIFIED'
        && request.resource.data.donationCount == 0;

      allow update: if (isOwner(donorId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'verificationStatus', 'donationCount'
        ])) || isAdmin();

      allow delete: if isOwner(donorId) || isAdmin();
    }

    // 3. Blood Requests Collection
    match /blood_requests/{requestId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'PENDING';

      allow update: if isAuthenticated() && (
        isOwner(resource.data.requesterUid) ||
        isAdmin() ||
        (
          resource.data.status == 'PENDING' &&
          request.resource.data.status == 'ACCEPTED' &&
          request.resource.data.acceptedDonorUid == request.auth.uid
        )
      );

      allow delete: if (isAuthenticated() && isOwner(resource.data.requesterUid)) || isAdmin();
    }

    // 4. Donation Records Collection
    match /donations/{donationId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.donorUid) ||
        isAdmin() ||
        (resource.data.verifiedByOrgId != null && isOrgAdmin(resource.data.verifiedByOrgId))
      );

      allow create, update, delete: if isAdmin() || (
        request.resource.data.verifiedByOrgId != null &&
        isOrgAdmin(request.resource.data.verifiedByOrgId)
      );
    }

    // 5. Organizations Collection
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOrgAdmin(orgId);
      allow delete: if isAdmin();

      match /campaigns/{campaignId} {
        allow read: if isAuthenticated();
        allow write: if isOrgAdmin(orgId);
      }
    }

    // 6. 1-to-1 Conversations and Messages
    match /conversations/{convId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
        );
        allow create: if isAuthenticated() && (
          request.auth.uid == request.resource.data.senderUid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
        );
        allow update, delete: if false;
      }
    }

    // 7. Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
