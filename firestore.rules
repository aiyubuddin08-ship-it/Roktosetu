rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions: Authentication, RBAC & Common Enum / Type Validators
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin privilege check:
    // Relies exclusively on Firebase Auth Custom Claim (`admin == true`) or
    // existence of `/admins/{uid}` in the admin registry collection (managed only via Firebase Console / Admin SDK).
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidBloodGroup(bg) {
      return bg is string && bg in [
        'A_POSITIVE', 'A_NEGATIVE', 'B_POSITIVE', 'B_NEGATIVE',
        'O_POSITIVE', 'O_NEGATIVE', 'AB_POSITIVE', 'AB_NEGATIVE'
      ];
    }

    function isValidDonorAvailability(avail) {
      return avail is string && avail in [
        'AVAILABLE', 'RESTING', 'EMERGENCY_ONLY', 'UNAVAILABLE'
      ];
    }

    function isValidVerificationStatus(st) {
      return st is string && st in [
        'UNVERIFIED', 'PENDING', 'PENDING_REVIEW', 'VERIFIED', 'REJECTED'
      ];
    }

    function isValidAccountStatus(st) {
      return st is string && st in [
        'ACTIVE', 'SUSPENDED', 'DELETED'
      ];
    }

    function isValidUrgency(u) {
      return u is string && u in [
        'STANDARD', 'HIGH', 'CRITICAL_EMERGENCY'
      ];
    }

    function isValidRequestStatus(s) {
      return s is string && s in [
        'PENDING', 'OPEN', 'DONOR_RESPONDED', 'ACCEPTED', 'FULFILLED', 'CANCELLED', 'EXPIRED'
      ];
    }

    // =========================================================================
    // Entity Schema Validators
    // =========================================================================

    function isValidUserProfile(data, userId) {
      return data.uid == userId
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && isValidBloodGroup(data.bloodGroup)
        && (!('isDonor' in data) || data.isDonor is bool)
        && (!('donorAvailability' in data) || isValidDonorAvailability(data.donorAvailability))
        && (!('isEmergencyDonor' in data) || data.isEmergencyDonor is bool)
        && (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 20))
        && (!('showPhonePublicly' in data) || data.showPhonePublicly is bool)
        && (!('division' in data) || (data.division is string && data.division.size() >= 2 && data.division.size() <= 60))
        && (!('district' in data) || (data.district is string && data.district.size() >= 2 && data.district.size() <= 60))
        && (!('upazila' in data) || (data.upazila is string && data.upazila.size() <= 80))
        && (!('area' in data) || (data.area is string && data.area.size() <= 120))
        && (!('city' in data) || (data.city is string && data.city.size() <= 60))
        && isValidVerificationStatus(data.verificationStatus)
        && data.role in ['USER', 'ORG_ADMIN', 'SUPER_ADMIN']
        && (!('accountStatus' in data) || isValidAccountStatus(data.accountStatus))
        && data.donationCount is int
        && data.donationCount >= 0
        && (!('badges' in data) || data.badges is list)
        && (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 500))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500));
    }

    function isValidPublicDonor(data, userId) {
      return data.uid == userId
        && data.isDonor == true
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && isValidBloodGroup(data.bloodGroup)
        && (!('availability' in data) || isValidDonorAvailability(data.availability))
        && (!('division' in data) || (data.division is string && data.division.size() >= 2 && data.division.size() <= 60))
        && (!('district' in data) || (data.district is string && data.district.size() >= 2 && data.district.size() <= 60))
        && (!('upazila' in data) || (data.upazila is string && data.upazila.size() <= 80))
        && (!('area' in data) || (data.area is string && data.area.size() <= 120))
        && (!('generalLocation' in data) || (data.generalLocation is string && data.generalLocation.size() <= 250))
        && (!('isEmergencyDonor' in data) || data.isEmergencyDonor is bool)
        && data.showPhonePublicly is bool
        && data.contactPhone is string
        && data.contactPhone.size() <= 20
        && (!data.showPhonePublicly || data.contactPhone.size() >= 8)
        && (data.showPhonePublicly || data.contactPhone == '')
        && isValidVerificationStatus(data.verificationStatus)
        && data.donationCount is int
        && data.donationCount >= 0;
    }

    function getReqOwnerUid(data) {
      return ('requesterUid' in data && data.requesterUid is string && data.requesterUid.size() > 0)
        ? data.requesterUid
        : (('requesterId' in data && data.requesterId is string) ? data.requesterId : '');
    }

    function getReqUnits(data) {
      return ('unitsRequired' in data && data.unitsRequired is int)
        ? data.unitsRequired
        : (('bagsNeeded' in data && data.bagsNeeded is int) ? data.bagsNeeded : 0);
    }

    function isValidBloodRequest(data) {
      let ownerUid = getReqOwnerUid(data);
      let units = getReqUnits(data);
      return ownerUid.size() >= 1
        && ownerUid.size() <= 128
        && (!('requesterName' in data) || (data.requesterName is string && data.requesterName.size() <= 100))
        && data.patientName is string
        && data.patientName.size() >= 2
        && data.patientName.size() <= 100
        && (!('patientAge' in data) || (data.patientAge is int && data.patientAge >= 0 && data.patientAge <= 130))
        && isValidBloodGroup(data.bloodGroup)
        && units >= 1
        && units <= 15
        && (!('unitsFulfilled' in data) || (data.unitsFulfilled is int && data.unitsFulfilled >= 0 && data.unitsFulfilled <= units))
        && (!('bagsPledged' in data) || (data.bagsPledged is int && data.bagsPledged >= 0 && data.bagsPledged <= units))
        && data.hospitalName is string
        && data.hospitalName.size() >= 2
        && data.hospitalName.size() <= 150
        && (!('hospitalAddress' in data) || (data.hospitalAddress is string && data.hospitalAddress.size() <= 250))
        && (!('division' in data) || (data.division is string && data.division.size() >= 2 && data.division.size() <= 60))
        && (!('district' in data) || (data.district is string && data.district.size() >= 2 && data.district.size() <= 60))
        && (!('upazila' in data) || (data.upazila is string && data.upazila.size() <= 80))
        && (!('area' in data) || (data.area is string && data.area.size() <= 120))
        && (!('city' in data) || (data.city is string && data.city.size() >= 2 && data.city.size() <= 60))
        && (!('urgency' in data) || isValidUrgency(data.urgency))
        && isValidRequestStatus(data.status)
        && data.contactPhone is string
        && data.contactPhone.size() >= 8
        && data.contactPhone.size() <= 16
        && (!('medicalReason' in data) || (data.medicalReason is string && data.medicalReason.size() <= 500))
        && (!('createdAt' in data) || data.createdAt is int)
        && (!('updatedAt' in data) || data.updatedAt is int)
        && (!('expiresAt' in data) || data.expiresAt is int);
    }

    function isValidReportCreate(data) {
      return data.reporterUid == request.auth.uid
        && (!('reporterName' in data) || (data.reporterName is string && data.reporterName.size() <= 100))
        && data.targetUid is string
        && data.targetUid.size() >= 1
        && data.targetUid.size() <= 128
        && data.targetUid != request.auth.uid
        && (!('targetName' in data) || (data.targetName is string && data.targetName.size() <= 150))
        && data.targetType is string
        && data.targetType in ['USER', 'REQUEST', 'DONOR', 'CHAT', 'GENERAL']
        && data.category is string
        && data.category in ['FAKE_REQUEST', 'HARASSMENT', 'WRONG_INFO', 'MISUSE', 'SPAM', 'OTHER']
        && (!('reasonBn' in data) || (data.reasonBn is string && data.reasonBn.size() <= 200))
        && data.details is string
        && data.details.size() >= 10
        && data.details.size() <= 500
        && (!('severity' in data) || (data.severity is string && data.severity in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL']))
        && data.status == 'OPEN'
        && (!('createdAt' in data) || data.createdAt is int);
    }

    function isValidAnnouncement(data) {
      return data.titleBn is string
        && data.titleBn.size() >= 3
        && data.titleBn.size() <= 200
        && data.bodyBn is string
        && data.bodyBn.size() >= 5
        && data.bodyBn.size() <= 2000
        && (!('category' in data) || (data.category is string && data.category in ['GENERAL', 'EMERGENCY', 'MAINTENANCE', 'CAMPAIGN']))
        && (!('targetAudience' in data) || (data.targetAudience is string && data.targetAudience in ['ALL_USERS', 'ACTIVE_DONORS', 'VERIFIED_DONORS', 'ORGANIZATIONS']))
        && (!('targetDivision' in data) || (data.targetDivision is string && data.targetDivision.size() <= 60))
        && (!('targetDistrict' in data) || (data.targetDistrict is string && data.targetDistrict.size() <= 60))
        && data.status is string
        && data.status in ['DRAFT', 'PUBLISHED']
        && (!('createdByUid' in data) || (data.createdByUid is string && data.createdByUid.size() <= 128))
        && (!('createdByEmail' in data) || (data.createdByEmail is string && data.createdByEmail.size() <= 150))
        && (!('createdAt' in data) || data.createdAt is int)
        && (!('publishedAt' in data) || data.publishedAt == null || data.publishedAt is int)
        && (!('recipientCount' in data) || (data.recipientCount is int && data.recipientCount >= 0));
    }

    // =========================================================================
    // 0. ADMIN REGISTRY (/admins/{adminId})
    // Client writes are completely disabled; managed strictly via Firebase Console / Admin SDK.
    // =========================================================================
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // 1. PRIVATE USER PROFILES (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && isValidUserProfile(request.resource.data, userId)
        && request.resource.data.role == 'USER'
        && request.resource.data.verificationStatus == 'UNVERIFIED'
        && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == 'ACTIVE')
        && request.resource.data.donationCount == 0
        && (!('isEmergencyDonor' in request.resource.data) || request.resource.data.isEmergencyDonor == false)
        && (!('badges' in request.resource.data) || request.resource.data.badges.size() == 0);

      allow update: if isAdmin() || (
        isOwner(userId)
        && isValidUserProfile(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && (!('accountStatus' in resource.data) || request.resource.data.accountStatus == resource.data.accountStatus)
        && request.resource.data.donationCount == resource.data.donationCount
        && (!('badges' in resource.data) || request.resource.data.badges == resource.data.badges)
      );

      allow delete: if isOwner(userId) || isAdmin();

      // Ordinary users cannot create notifications for others; only admins or Cloud Functions can create.
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if isAdmin()
          && request.resource.data.recipientUid == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 200
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 1000
          && request.resource.data.isRead == false;
      }
    }

    // =========================================================================
    // 2. PUBLIC DONOR DIRECTORY (/public_donors/{userId})
    // =========================================================================
    match /public_donors/{userId} {
      allow read: if isSignedIn();

      allow create: if isAdmin() || (
        isOwner(userId)
        && isValidPublicDonor(request.resource.data, userId)
        && request.resource.data.verificationStatus == 'UNVERIFIED'
        && request.resource.data.donationCount == 0
      );

      allow update: if isAdmin() || (
        isOwner(userId)
        && isValidPublicDonor(request.resource.data, userId)
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.donationCount == resource.data.donationCount
        && (!('badges' in resource.data) || request.resource.data.badges == resource.data.badges)
      );

      allow delete: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 3. BLOOD REQUESTS (/blood_requests/{requestId})
    // =========================================================================
    match /blood_requests/{requestId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isValidBloodRequest(request.resource.data)
        && getReqOwnerUid(request.resource.data) == request.auth.uid
        && request.resource.data.status in ['PENDING', 'OPEN']
        && (!('unitsFulfilled' in request.resource.data) || request.resource.data.unitsFulfilled == 0)
        && (!('bagsPledged' in request.resource.data) || request.resource.data.bagsPledged == 0)
        && (!('acceptedDonorUid' in request.resource.data) || request.resource.data.acceptedDonorUid == null);

      allow update: if isAdmin()
        // (4a) Request owner editing allowed details while status is PENDING or OPEN
        || (
          isSignedIn()
          && getReqOwnerUid(resource.data) == request.auth.uid
          && resource.data.status in ['PENDING', 'OPEN']
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'patientName', 'patientAge', 'unitsRequired', 'bagsNeeded',
            'hospitalName', 'hospitalAddress', 'division', 'district',
            'upazila', 'area', 'area_lower', 'city', 'urgency',
            'contactPhone', 'medicalReason', 'updatedAt'
          ])
          && isValidBloodRequest(request.resource.data)
        )
        // (4b) Request owner cancelling or marking fulfilled via status + updatedAt only
        || (
          isSignedIn()
          && getReqOwnerUid(resource.data) == request.auth.uid
          && resource.data.status in ['PENDING', 'OPEN', 'DONOR_RESPONDED', 'ACCEPTED']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['CANCELLED', 'FULFILLED']
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is int)
        )
        // (4c) Non-owner donor accepting / responding to an open/pending request
        || (
          isSignedIn()
          && getReqOwnerUid(resource.data) != request.auth.uid
          && resource.data.status in ['PENDING', 'OPEN', 'DONOR_RESPONDED']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acceptedDonorUid', 'acceptedDonorName',
            'respondedDonorUids', 'acceptedDonorIds',
            'unitsFulfilled', 'bagsPledged', 'updatedAt'
          ])
          && request.resource.data.status in ['OPEN', 'PENDING', 'DONOR_RESPONDED', 'ACCEPTED']
          && (
            (!('acceptedDonorUid' in request.resource.data) || request.resource.data.acceptedDonorUid == request.auth.uid)
            && (!('acceptedDonorName' in request.resource.data) || (
              request.resource.data.acceptedDonorName is string
              && request.resource.data.acceptedDonorName.size() >= 2
              && request.resource.data.acceptedDonorName.size() <= 100
            ))
            && (!('respondedDonorUids' in request.resource.data) || (
              request.resource.data.respondedDonorUids is list
              && request.resource.data.respondedDonorUids.size() <= 20
              && (request.auth.uid in request.resource.data.respondedDonorUids)
            ))
            && (!('acceptedDonorIds' in request.resource.data) || (
              !(request.auth.uid in resource.data.acceptedDonorIds)
              && request.resource.data.acceptedDonorIds.hasAll(resource.data.acceptedDonorIds)
              && request.resource.data.acceptedDonorIds.size() == resource.data.acceptedDonorIds.size() + 1
              && (request.auth.uid in request.resource.data.acceptedDonorIds)
            ))
            && (!('unitsFulfilled' in request.resource.data) || (
              request.resource.data.unitsFulfilled is int
              && request.resource.data.unitsFulfilled >= 1
              && request.resource.data.unitsFulfilled <= getReqUnits(resource.data)
            ))
            && (!('bagsPledged' in request.resource.data) || (
              request.resource.data.bagsPledged == resource.data.bagsPledged + 1
            ))
          )
        );

      allow delete: if isAdmin() || (isSignedIn() && getReqOwnerUid(resource.data) == request.auth.uid);
    }

    // =========================================================================
    // 4. DONATION HISTORY (/donation_history/{recordId})
    // =========================================================================
    match /donation_history/{recordId} {
      allow read: if isSignedIn() && (
        resource.data.donorId == request.auth.uid
        || ('donorUid' in resource.data && resource.data.donorUid == request.auth.uid)
        || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.donorId == request.auth.uid
        && request.resource.data.bags == 1
        && request.resource.data.hospitalName is string
        && request.resource.data.hospitalName.size() >= 2
        && request.resource.data.hospitalName.size() <= 150
        && (isAdmin() || request.resource.data.verifiedByRequester == false);
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. CHAT CONVERSATIONS & MESSAGES (/conversations/{conversationId})
    // =========================================================================
    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() && (
          ('participantIds' in resource.data && request.auth.uid in resource.data.participantIds)
          || ('participants' in resource.data && request.auth.uid in resource.data.participants)
        );
      }
      function isCreatingParticipant() {
        return isSignedIn() && (
          ('participantIds' in request.resource.data
            && request.resource.data.participantIds is list
            && request.resource.data.participantIds.size() == 2
            && request.auth.uid in request.resource.data.participantIds)
          || ('participants' in request.resource.data
            && request.resource.data.participants is list
            && request.resource.data.participants.size() == 2
            && request.auth.uid in request.resource.data.participants)
        );
      }

      allow read: if isParticipant() || isAdmin();
      allow create: if isCreatingParticipant();
      allow update: if isParticipant()
        && (!('participantIds' in resource.data) || request.resource.data.participantIds == resource.data.participantIds)
        && (!('participants' in resource.data) || request.resource.data.participants == resource.data.participants);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function isConvParticipant() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return ('participantIds' in conv && request.auth.uid in conv.participantIds)
            || ('participants' in conv && request.auth.uid in conv.participants);
        }

        allow read: if isSignedIn() && (isConvParticipant() || isAdmin());
        allow create: if isSignedIn()
          && isConvParticipant()
          && (
            ('senderId' in request.resource.data && request.resource.data.senderId == request.auth.uid)
            || ('senderUid' in request.resource.data && request.resource.data.senderUid == request.auth.uid)
          )
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // 6. ORGANIZATIONS & CAMPAIGNS (/organizations/{orgId}, /campaigns/{campaignId})
    // =========================================================================
    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 150
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2;
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. REPORTS & COMPLAINTS (/reports/{reportId})
    // =========================================================================
    match /reports/{reportId} {
      allow create: if isSignedIn() && isValidReportCreate(request.resource.data);
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 8. VERIFICATION REQUESTS (/verification_requests/{reqId})
    // =========================================================================
    match /verification_requests/{reqId} {
      allow create: if isSignedIn()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.documentSummary is string
        && request.resource.data.documentSummary.size() >= 3
        && request.resource.data.documentSummary.size() <= 500;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 9. ADMIN AUDIT LOGS (/audit_logs/{logId})
    // =========================================================================
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // =========================================================================
    // 10. SYSTEM CONFIGURATION (/system_settings/{docId})
    // =========================================================================
    match /system_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 11. BLOOD BANKS (/blood_banks/{bankId})
    // =========================================================================
    match /blood_banks/{bankId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 150
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.contactPhone is string
        && request.resource.data.contactPhone.size() >= 3
        && request.resource.data.contactPhone.size() <= 20;
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 12. AMBULANCES (/ambulances/{ambulanceId})
    // =========================================================================
    match /ambulances/{ambulanceId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.providerName is string
        && request.resource.data.providerName.size() >= 2
        && request.resource.data.providerName.size() <= 150
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 3
        && request.resource.data.phone.size() <= 20;
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 13. BLOOD DONATION CAMPS (/blood_camps/{campId}) & RSVPs
    // =========================================================================
    match /blood_camps/{campId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 150
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.contactPhone is string
        && request.resource.data.contactPhone.size() >= 3
        && request.resource.data.contactPhone.size() <= 20;
      allow delete: if isAdmin();

      match /rsvps/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.campId == campId;
        allow delete: if isOwner(uid) || isAdmin();
        allow update: if false;
      }
    }

    // =========================================================================
    // 14. SYSTEM ANNOUNCEMENTS (/announcements/{announcementId})
    // =========================================================================
    match /announcements/{announcementId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.status == 'PUBLISHED');
      allow create, update: if isAdmin() && isValidAnnouncement(request.resource.data);
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 15. SECURITY ALERTS (/security_alerts/{alertId})
    // =========================================================================
    match /security_alerts/{alertId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.alertType is string
        && request.resource.data.alertType.size() >= 2
        && request.resource.data.alertType.size() <= 80
        && (!('severity' in request.resource.data) || request.resource.data.severity in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'])
        && request.resource.data.reviewStatus in ['OPEN', 'REVIEWED', 'RESOLVED', 'DISMISSED'];
      allow delete: if isAdmin();
    }
  }
}
